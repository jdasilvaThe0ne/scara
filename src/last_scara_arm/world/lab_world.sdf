<?xml version ='1.0'?>
<sdf version ="1.8">
 <world name="science_lab">
  <plugin
    filename="gz-sim-physics-system"
    name="gz::sim::systems::Physics">
  </plugin>
  <plugin filename="gz-sim-user-commands-system" 
          name="gz::sim::systems::UserCommands"/>
   <plugin
    filename="gz-sim-scene-broadcaster-system"
    name="gz::sim::systems::SceneBroadcaster">
  </plugin>
  <plugin
    filename="gz-sim-sensors-system"
    name="gz::sim::systems::Sensors">
  </plugin>

 
 
  <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>true</grid>
    </scene>

  <physics name="default_physics" type="ode">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
  </physics>
  
  <light name='overhead_light' type='directional'>
   <pose> 0 0 10 0 0 0</pose>
   <direction> 0 0 -1</direction>
   <diffuse> 1 1 1 1</diffuse>
   <specular>1 1 1 1</specular>
   <attenuation>
    <range>60</range>
    <constant>0.9</constant>
    <linear>0.01</linear>
    <quadratic>0.001</quadratic>
    </attenuation>
    </light>
   
  

 <!-- Lighting-->
 <!--include>
  <uri>model://sun</uri>
 </include-->
 <!--ground-->
 <!--include>
  <uri>model://ground_plane</uri>
 </include-->
 <!--Table-->
 <model name="ground_plane">
  <static>true</static>
  <pose>0 0 0 0 0 0</pose>

  <link name="ground_link">
    <collision name="collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      
    </visual>
  </link>
</model>
  <!--green table-->
<model name="Table_left">
  <static>true</static>
  <pose>0.1 0.9 0.4 0 0 0</pose>

  <link name="table_link">
    <collision name="collision">
      <geometry>
        <box>
          <size>1.2 0.6 0.05</size>
        </box>
      </geometry>
    </collision>

    <visual name="visual">
      <geometry>
        <box>
          <size>1.2 0.6 0.05</size>
        </box>
      </geometry>
      <material>
      <!--green-->
      <ambient>0.2 0.8 0.2 1</ambient>
        <diffuse>0.3 0.9 0.3 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <shininess>25</shininess>
    </material>
    </visual>
  </link>
</model>
<!--Pink Front table-->
<model name="Table_center">
  <static>true</static>
  <pose>1 0 0.4 0 0 0</pose>

  <link name="table_link">
   <visual name="visual">
      <geometry>
        <box>
          <size>0.6 2.4 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.45 0.25 0.6 1</ambient>
        <diffuse>0.6 0.35 0.8 1</diffuse>
        <specular>0.25 0.25 0.25 1</specular>
        <shininess>35</shininess>
      </material>

    </visual>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.6 2.4 0.05</size>
        </box>
      </geometry>
    </collision>

   
  </link>
</model>



<model name="Table_right">
  <static>true</static>
  <pose>0.1 -0.9 0.4 0 0 0</pose>

  <link name="table_link">
  <visual name="visual">
      <geometry>
        <box>
          <size>1.2 0.6 0.05</size>
        </box>
      </geometry>
      <material>
        <ambient>0.2 0.3 0.8 1</ambient>
        <diffuse>0.3 0.4 0.9 1</diffuse>
        <specular>0.25 0.25 0.25 1</specular>
        <shininess>30</shininess>
      </material>
    </visual>
    <collision name="collision">
      <geometry>
        <box>
          <size>1.2 0.6 0.05</size>
        </box>
      </geometry>
    </collision>

    
  </link>
</model>



<model name="imput_tray1">
  <static>false</static>
 <pose>1 0.5 0.44 0 0 1.5708</pose>

  <link name="tray_link">
    <inertial> 
     <mass>0.5</mass>
     <inertia>
      <ixx>0.002</ixx>
      <iyy>0.002</iyy>
      <izz>0.001</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
     </inertia>
     </inertial>

      
    <collision name='collision'>
     <surface>
     <friction>
       <ode>
       <mu>1.2</mu>
       <mu2>1.2</mu2>
       </ode>
      </friction>
     </surface>


     <geometry>
      <box>
       <size>0.8 0.3 0.02</size>
      </box>
     </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.8 0.3 0.02</size>
        </box>
      </geometry>

      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>1 1 1 1</specular>
        <shininess>80</shininess>
      </material>
    </visual>
  </link>
</model>
<model name="imput_tray2">
  <static>false</static>
 <pose>1 -0.5 0.44 0 0 1.5708</pose>

  <link name="tray_link">
    <inertial> 
     <mass>0.5</mass>
     <inertia>
      <ixx>0.002</ixx>
      <iyy>0.002</iyy>
      <izz>0.004</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
     </inertia>
     </inertial>

      
    <collision name='collision'>
     <surface>
     <friction>
       <ode>
       <mu>1.2</mu>
       <mu2>1.2</mu2>
       </ode>
      </friction>
     </surface>


     <geometry>
      <box>
       <size>0.8 0.3 0.02</size>
      </box>
     </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.8 0.3 0.02</size>
        </box>
      </geometry>

      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>1 1 1 1</specular>
        <shininess>80</shininess>
      </material>
    </visual>
  </link>
</model>

<!-- Plastic Petri dish-->
<model name="petri_dish_1">
 <pose>1 0.5 0.4551 0 0 0</pose>
 <link name="petri_link">
  <inertial>
   <mass>0.03</mass>
   <inertia>
    <ixx>2.0e-5</ixx>
    <iyy>2.0e-5</iyy>
    <izz>3.5e-5</izz>
    <ixz>0</ixz>
    <iyz>0</iyz>
   </inertia>

  </inertial>
  <collision name="collision">
    <surface>
     <friction>
      <ode>
       <mu>0.6</mu>
       <mu2>0.6</mu2>

      </ode>
     </friction>
     <contact>
      <ode>
       <kp>30000</kp>
       <kd>10</kd>
       <max_vel>0.01</max_vel>
       <min_depth>0.001</min_depth>
      </ode>
      </contact>
     </surface>

    <geometry>
     <cylinder>
      <radius>0.045</radius>
      <length>0.03</length>
     </cylinder>
    </geometry>
   </collision>
   <visual name="visual">
    <geometry>
     <cylinder>
      <radius>0.045</radius>
      <length>0.01</length>
     </cylinder>
    </geometry>
     <material>
  <ambient>0.0 0.5 0.8 0.6</ambient> 
  <diffuse>0.0 0.5 0.8 0.6</diffuse>
  <specular>1 1 1 1</specular>
  <emissive>0.0 0.3 0.5 1</emissive>
  <shininess>50</shininess>
</material>
    </visual>
    </link>
 </model>
 <!--Cylinder /test tube-->
  <model name="test_tube_1">
   <pose>1 0.42 0.511 0 0 0 </pose>
    <link name='test_tube_link'>
     <inertial>
      <mass>0.06</mass>
      <inertia>
       <ixx>7.8e-5</ixx>
       <iyy>7.8e-5</iyy>
       <izz>1.2e-5</izz>
       <ixy>0</ixy>
       <ixz>0</ixz>
       <iyz>0</iyz>

      </inertia>

     </inertial>

     <collision name='collision'>
      <surface>
      
       <friction>
        <ode>
          <mu>0.45</mu>
          <mu2>0.45</mu2>
        </ode>
        </friction>
       <contact>
        <ode>
         <kp>25000</kp> <!--softness-->
         <kd>8</kd>
        </ode>
       </contact>
      </surface>

      <geometry>
       <cylinder>
        <radius>0.02</radius>
        <length>0.12</length>
       </cylinder>
      </geometry>
      </collision>
      <visual name='visual'>
      <geometry>
      <cylinder>
      <radius>0.02</radius>
      <length>0.12</length>
      </cylinder>
      </geometry>
   <material>
  <ambient>0.0 0.5 0.8 0.6</ambient> 
  <diffuse>0.0 0.5 0.8 0.6</diffuse>
  <specular>1 1 1 1</specular>
  <emissive>0.0 0.3 0.5 1</emissive>
  <shininess>50</shininess>
</material>


    </visual>
    </link>
   </model>
  
<model name="world_camera">
  <static>true</static>
  <!--pose>1 0 2 0 -1.57 0</pose-->
  <pose>0.5 0 2.5 -1.57 1.57  -1.57 </pose>


  <link name="camera_link">
    <visual name='visual'>
    <geometry>
        <box>
          <size>0.05 0.05 0.05</size>
        </box>
      </geometry>
      <material>
  <ambient>0.5 0.0 0.5 0.6</ambient>
  <diffuse>0.6 0.1 0.7 0.6</diffuse>
  <specular>1 1 1 1</specular>
  <emissive>0.3 0.0 0.4 1</emissive>
  <shininess>50</shininess>
</material>

    </visual>
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </link>
</model>

  </world>
  </sdf>



