<?xml version="1.1"?>
<robot name="scara_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
<link name="world"/>
<joint name="world_fixed" type="fixed">
  <parent link="world"/>
  <child link="base_link"/>
</joint>
  <!-- MATERIALS -->
  <material name="gray">
    <color rgba="0.7 0.7 0.7 1"/>
  </material>

  <material name="blue">
    <color rgba="0.2 0.2 0.8 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>

  <material name="green">
    <color rgba="0.2 0.8 0.2 1"/>
  </material>

  <!-- BASE LINK -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.2" radius="0.25"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.2" radius="0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="25.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- LINK 1  old link body -->
  <link name="link1">
    <visual>
      <geometry>
        <cylinder length="0.4" radius="0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <cylinder length="0.4" radius="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.2"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.01"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="0.5"/>
    <dynamics damping="1.5" friction="1.0"/>
    <gazebo>
    <initial_position>1.62</initial_position>
    </gazebo>
  </joint>
  <!--new body link-->
  <!--link name="link1">
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.2"/>
      <inertia ixx="0.03" iyy="0.03" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <visual>
      <origin xyz="0.025 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.1 0.4"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="-0.025 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.1 0.4"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.4"/>
      </geometry>
    </collision>
  </link-->
  <!--new body link completed-->

  <!-- LINK 2 -->
  <link name="main_arm">
    <visual>
      <origin xyz='0.2 0 0' rpy='0 0 0'/>
      <geometry>
        <box size="0.4 0.05 0.05"/>
      
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz='0.2 0 0' rpy='0 0 0'/>
      <geometry>
        <box size="0.4 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.5"/>
      <origin xyz="0.2 0 0"/>
      <inertia ixx="0.12" iyy="0.15" izz="0.15"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="main_arm"/>
    <origin xyz="0 0 0.2" rpy='0 0 0'/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="200" velocity="0.2"/>
    <dynamics damping="12.0" friction="4.0"/>
  </joint>

  <!-- LINK 3 (PRISMATIC) -->
  <link name="link3">
    <visual>
      <origin xyz='0 0 0' rpy='0 0 0'/>
      <geometry>

        <box size='0.39 0.04 0.04'/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size='0.39 0.04 0.04'/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.002"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!--gazebo>
    <initial_position>0.75</initial_position>
    </gazebo-->
  </link>

  <joint name="joint3" type="prismatic">
    <parent link="main_arm"/>
    <child link="link3"/>
    <origin xyz="0.21 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.39" effort="50" velocity="0.2"/>
    <dynamics damping="10.0" friction="1.0"/>

  </joint>
  
  <!--link name="link_sleeve">
   <visual>
    <origin xyz='0 0 0' rpy='0 1.5708 0'/>
    <geometry>
      <cylinder length="0.4" radius="0.05"/>
    </geometry>

   </visual>
   <collision>
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <geometry>
      <cylinder length="0.4" radius="0.05"/>
    </geometry>
  </collision>
</link-->


  <!-- TOOL -->
  <link name="tool0">
    <visual>
      <origin xyz='0 0 0' rpy='0 0 0'/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <origin xyz='0 0 0' rpy='0 0 0'/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="tool0"/>
    <origin xyz="0.195 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="1"/>
     <dynamics damping="5.0" friction="2.0"/>
    
  </joint>

  <link name="gripper_base">

  <visual>
    <origin xyz='0 0 0'/>
    <geometry>
      <box size="0.08 0.08 0.02"/>
    </geometry>
    <material name="red"/>
  </visual>

  <collision>
    <origin xyz='0 0 0'/>
    <geometry>
      <box size="0.08 0.08 0.02"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="0.2"/>
    <inertia
  ixx="3.5e-4"
  iyy="3.5e-4"
  izz="1.0e-4"
  ixy="0" ixz="0" iyz="0"/>
  </inertial>

</link>


    <joint name="gripper_mount"  type='fixed'>
    <parent link='tool0'/>
    <child link='gripper_base'/>
    <origin xyz="0 0 -0.05"/>
    </joint>

<link name='left_finger'>
    <visual>
     <origin xyz='0 0 0'/>
     <geometry>
      <box size='0.02 0.02 0.039'/>
     </geometry>
     <material name='gray'/>
     </visual>
     <collision>
      <origin xyz='0 0 0'/>
      <geometry>
       <box size="0.02 0.02 0.039"/>
      </geometry>
          
     </collision>
     <inertial>
      <origin xyz='0 0 0'/>
      <mass value="0.1"/>
         <inertia ixx="1e-5" iyy="1e-5" izz="2e-5"
             ixy="0" ixz="0" iyz="0"/>
     </inertial>
    <!--gazebo reference="left_finger">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
    </gazebo-->
</link>

<joint name="left_finger_joint" type="prismatic">
  <parent link="gripper_base"/>
  <child link="left_finger"/>
  <origin xyz="0.04 0 -0.0295"/>
  <axis xyz="1 0 0"/>
  <limit lower="-0.025" upper="0.025" effort="10" velocity="0.05"/>
    <dynamics damping="5.0" friction="2.0"/>
</joint>

<link name="right_finger">
  <visual>
  <origin xyz='0 0 0'/>
    <geometry>
      <box size="0.02 0.02 0.039"/>
    </geometry>
    <material name="blue"/>
  </visual>

  <collision>
    <origin  xyz='0 0 0'/>
    <geometry>
      <box size="0.02 0.02 0.039"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.1"/>
    <origin xyz="0 0 0"/>
    <inertia ixx="1e-5" iyy="1e-5" izz="2e-5"
             ixy="0" ixz="0" iyz="0"/>
  </inertial>
  <!--gazebo reference="right_finger">
  <mu1>2.0</mu1>
  <mu2>2.0</mu2>
</gazebo-->
</link>

<joint name="right_finger_joint" type="prismatic">
  <parent link="gripper_base"/>
  <child link="right_finger"/>
  <origin xyz="-0.04 0 -0.0295"/>
  <axis xyz="1 0 0"/>
  <limit lower="0.0" upper="0.025" effort="10" velocity="0.05"/>
  <dynamics damping="5.0" friction="2.0"/>
</joint>
 <!-- cause prismatic joint to move-->
<ros2_control name="GazeboSystem" type="system">
  <hardware>
    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
  </hardware>
  <joint name="joint1">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="joint2">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="joint3">
    <command_interface name="position"/>
    <state_interface name="position">
      <param name="initial_value">0.1</param>
    </state_interface>
    <state_interface name="velocity"/>
  </joint>
  <joint name="joint4">
    <command_interface name="position"/>
    <state_interface name="position">
      <param name="initial_value">0.1</param>
    </state_interface>
    <state_interface name="velocity"/>
  </joint>
  <joint name="left_finger_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
  <joint name="right_finger_joint">
    <command_interface name="position"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
  </joint>
</ros2_control>

<gazebo>
   

  <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <!--name="gz_ros2_control::GazeboSimSystem"-->
    <parameters>
      /home/justinodasilva/arm/src/last_scara_arm/urdf/scara_controllers.yml
    </parameters>
  </plugin>
</gazebo>

</robot>


